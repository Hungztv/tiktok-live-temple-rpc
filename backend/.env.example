# Chỉ bind localhost mặc định
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# SQLite (async). Mặc định: backend/game.db
# DATABASE_URL=sqlite+aiosqlite:///./game.db

# CORS: origin của frontend, phân tách bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# TikTok
TIKTOK_USERNAME=
# Tuỳ chọn: khoá Sign API (nếu có) để kết nối ổn định hơn
SIGN_API_KEY=

# AI Caster: template | gemini | ollama  (mặc định template, lỗi sẽ tự fallback)
LLM_PROVIDER=template
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
